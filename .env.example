# PostgreSQL connection string (Neon in production)
DATABASE_URL=

# Long random string used to sign admin session cookies. Required in production.
ADMIN_SESSION_SECRET=

# Public site URL used for metadata, sitemap and canonical URLs
NEXT_PUBLIC_SITE_URL=

# Used only by the one-off seed script to create the first admin user
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Optional: Vercel Blob storage token for media uploads in production.
# If not set, uploads are stored under /public/uploads (fine for local/dev).
BLOB_READ_WRITE_TOKEN=
